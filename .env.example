# Copy this file to `.env` and fill in the value. `.env` is git-ignored.
#
#     cp .env.example .env
#
# The pipeline runs fully without a key: the deterministic path handles every
# document it recognises, and anything it cannot read is escalated rather than
# guessed. A key switches on the fallbacks — classification for low-confidence
# emails, extraction for fields the rules could not read, and reading scanned
# documents — so the model is used where the system admits it is unsure.

# --- required for the model fallbacks -------------------------------------
# Put the real value in `.env`, never here. THIS file is committed to the
# repository; `.env` is git-ignored. They differ by one character and by
# everything that matters.
OPENAI_API_KEY=

# --- optional: which models to use ----------------------------------------
# Leave unset to use the defaults in backend/sdoc/llm/config.py.
# SENTINEL_LLM_MODEL=
# SENTINEL_VISION_MODEL=

# --- optional: guard rails -------------------------------------------------
# Hard ceiling on model spend for a single run, in USD. The pipeline stops
# calling the model and escalates instead of silently running up a bill.
# SENTINEL_RUN_BUDGET_USD=2.00

# Cache model responses by content hash so a re-run costs nothing and gives
# the same answer. Set to 0 only when you want to re-measure cost or latency.
# SENTINEL_LLM_CACHE=1
