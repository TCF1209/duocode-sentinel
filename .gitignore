# --- data: never commit the dataset or (especially) the answer key ---
# Anchored with a leading slash on purpose. An unanchored `runs/` matches a
# directory of that name at ANY depth, and it silently ate the dashboard's
# whole `web/app/runs/` route tree — three page files that `git status` never
# mentioned and `git add` refused without a word. Keep the slash.
/data/
*.zip
ground_truth.json
submission*.json
/runs/
/.cache/

# --- python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.local

# --- node / next ---
node_modules/
.next/
out/
.vercel/

# --- os ---
.DS_Store
Thumbs.db
.cache/

# Office lock files, left beside a .pptx/.docx while it is open in PowerPoint/Word.
~$*
